<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Smart Water Tank System</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&display=swap">
<style>
:root{--bg:#eef5f7;--card:#fff;--ink:#0d2a35;--mute:#5a7480;--line:#d3e2e8;--water:#1c9ad6;--water2:#0b6fa8;--ok:#1f9d63;--warn:#e0a100;--bad:#d64545;--shadow:0 1px 2px rgba(13,42,53,.08);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0a1a21;--card:#10252e;--ink:#e6f2f6;--mute:#8fa9b4;--line:#21404c;--shadow:none}}
:root[data-theme="dark"]{--bg:#0a1a21;--card:#10252e;--ink:#e6f2f6;--mute:#8fa9b4;--line:#21404c;--shadow:none}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Sora',system-ui,-apple-system,'Segoe UI',sans-serif;line-height:1.5}
main{max-width:980px;margin:0 auto;padding:20px 16px 40px}
header{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:18px}
h1{font-size:1.5rem;margin:0}
.clock{color:var(--mute);font-size:.9rem;font-variant-numeric:tabular-nums}
.grid{display:grid;grid-template-columns:260px 1fr;gap:16px}
@media (max-width:700px){.grid{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;box-shadow:var(--shadow)}
h2{font-size:1rem;margin:0 0 10px}
.tankwrap{display:flex;flex-direction:column;align-items:center;gap:12px}
.tank{position:relative;width:150px;height:260px;border:3px solid var(--ink);border-radius:10px 10px 22px 22px;overflow:hidden;background:var(--bg)}
.water{position:absolute;left:0;right:0;bottom:0;height:0;background:linear-gradient(var(--water),var(--water2));transition:height .8s ease}
.water::before{content:"";position:absolute;left:-10%;right:-10%;top:-6px;height:12px;background:var(--water);border-radius:50%;opacity:.8}
.mark{position:absolute;left:0;right:0;border-top:2px dashed var(--ink);opacity:.45;font-size:.65rem;color:var(--ink)}
.mark span{position:absolute;right:4px;top:1px;background:var(--bg);padding:0 3px;border-radius:3px}
.level{position:absolute;inset:0;display:grid;place-items:center;font-size:2rem;font-weight:700;color:var(--ink);text-shadow:0 0 6px var(--bg),0 0 6px var(--bg)}
.pill{display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:99px;font-weight:600;font-size:.85rem;border:1px solid var(--line)}
.pill i{width:9px;height:9px;border-radius:50%;background:var(--mute)}
.pill.on i{background:var(--ok)}.pill.on{color:var(--ok)}
.stats{display:flex;gap:10px;margin-top:2px;font-size:.85rem;color:var(--mute)}
.stats b{color:var(--ink)}
.alert{padding:10px 12px;border-radius:8px;font-weight:600;font-size:.9rem;margin-bottom:12px;border:1px solid var(--line)}
.alert.crit{background:color-mix(in srgb,var(--bad) 16%,transparent);color:var(--bad)}
.alert.low{background:color-mix(in srgb,var(--warn) 18%,transparent);color:var(--warn)}
.alert.norm{background:color-mix(in srgb,var(--ok) 14%,transparent);color:var(--ok)}
.alert.high{background:color-mix(in srgb,var(--water) 16%,transparent);color:var(--water)}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:10px}
label{font-size:.85rem;color:var(--mute);min-width:90px}
input{width:90px;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font:inherit}
button{padding:8px 14px;border:0;border-radius:8px;background:var(--water2);color:#fff;font:inherit;font-weight:600;cursor:pointer}
button.alt{background:var(--card);color:var(--ink);border:1px solid var(--line)}
button:focus-visible,input:focus-visible{outline:3px solid var(--water);outline-offset:2px}
.msg{min-height:1.5em;font-size:.88rem;margin:4px 0 14px}
.msg.err{color:var(--bad)}.msg.ok{color:var(--ok)}
.hist{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
@media (max-width:700px){.hist{grid-template-columns:1fr}}
ul{list-style:none;margin:0;padding:0;max-height:180px;overflow:auto;font-size:.88rem}
li{padding:6px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between}
li.empty{color:var(--mute)}
.foot{margin-top:14px;font-size:.8rem;color:var(--mute)}
@media (prefers-reduced-motion:reduce){.water{transition:none}}
</style>
</head>
<body>
<main>
<header>
  <h1>Smart Water Tank System</h1>
  <div class="clock" id="clock" aria-live="off"></div>
</header>

<div class="grid">
  <section class="card tankwrap" aria-label="Tank status">
    <div class="tank" role="img" aria-label="Tank water level">
      <div class="water" id="water"></div>
      <div class="mark" style="bottom:30%"><span>Low 30%</span></div>
      <div class="mark" style="bottom:90%"><span>Full 90%</span></div>
      <div class="level" id="lvl">0%</div>
    </div>
    <span class="pill" id="motor"><i></i><span id="motorTxt">Motor OFF</span></span>
    <div class="stats">Total usage: <b id="total">0</b> units</div>
  </section>

  <section class="card">
    <div class="alert" id="alert" role="status"></div>

    <h2>Use water</h2>
    <div class="row">
      <label for="useAmt">Amount (%)</label>
      <input id="useAmt" type="number" min="1" max="100" value="10">
      <button id="useBtn">Use water</button>
    </div>

    <h2>Fill tank</h2>
    <div class="row">
      <label for="fillAmt">Amount (%)</label>
      <input id="fillAmt" type="number" min="1" max="100" value="20">
      <button id="fillBtn">Fill tank</button>
    </div>
    <div class="msg" id="msg" role="status"></div>

    <div class="row">
      <button class="alt" id="resetBtn">Reset with new sensor reading</button>
    </div>
    <p class="foot">The motor switches on at 30% or below and off at 90% or above. You can only fill while the motor is on.</p>
  </section>
</div>

<div class="hist">
  <section class="card"><h2>Usage history</h2><ul id="useList"></ul></section>
  <section class="card"><h2>Fill history</h2><ul id="fillList"></ul></section>
</div>
</main>

<script>
const LOW = 30, HIGH = 90;
const readSensor = () => Math.floor(Math.random() * 61) + 20; // simulated 20-80

let level = readSensor(), motorOn = false, totalUsage = 0;
const usageHistory = [], fillHistory = [];
const $ = id => document.getElementById(id);
const time = () => new Date().toLocaleTimeString('en-GB');

function control() {
  if (level <= LOW) motorOn = true;
  else if (level >= HIGH) motorOn = false;
}

function alertInfo() {
  if (level <= 5) return ['crit', 'Critical: tank almost empty (0-5%)'];
  if (level <= 15) return ['crit', 'Very low: water level very low (6-15%)'];
  if (level <= 30) return ['low', 'Low: water level low (16-30%)'];
  if (level <= 60) return ['norm', 'Normal: water level medium (31-60%)'];
  if (level <= 85) return ['high', 'High: water level high (61-85%)'];
  if (level < 100) return ['high', 'Very high: tank almost full (86-99%)'];
  return ['crit', 'Full: tank completely full (100%)'];
}

function renderList(el, items, verb) {
  el.innerHTML = items.length
    ? items.slice().reverse().map(([v, t]) => `<li><span>${verb} ${v}%</span><span>${t}</span></li>`).join('')
    : `<li class="empty">${verb === 'Used' ? 'No usage yet' : 'No filling yet'}</li>`;
}

function render() {
  control();
  level = Math.max(0, Math.min(100, level));
  $('water').style.height = level + '%';
  $('lvl').textContent = level + '%';
  $('motor').classList.toggle('on', motorOn);
  $('motorTxt').textContent = 'Motor ' + (motorOn ? 'ON' : 'OFF');
  $('total').textContent = totalUsage;
  const [cls, text] = alertInfo();
  const a = $('alert'); a.className = 'alert ' + cls; a.textContent = text;
  renderList($('useList'), usageHistory, 'Used');
  renderList($('fillList'), fillHistory, 'Added');
}

function say(text, kind) { const m = $('msg'); m.textContent = text; m.className = 'msg ' + kind; }

function amount(id) {
  const n = parseInt($(id).value, 10);
  if (!Number.isInteger(n) || n <= 0) { say('Enter a whole number greater than 0.', 'err'); return null; }
  return n;
}

$('useBtn').onclick = () => {
  const used = amount('useAmt'); if (used === null) return;
  if (used > level) return say(`Not enough water. Only ${level}% is available.`, 'err');
  level -= used; totalUsage += used;
  usageHistory.push([used, time()]);
  say(`Used ${used}% water.`, 'ok');
  render();
};

$('fillBtn').onclick = () => {
  const added = amount('fillAmt'); if (added === null) return;
  if (!motorOn) return say('Motor is off, so the tank cannot be filled. It turns on at 30% or below.', 'err');
  if (level + added > 100) return say(`Tank would overflow. You can add up to ${100 - level}%.`, 'err');
  level += added;
  fillHistory.push([added, time()]);
  say(`Added ${added}% water.`, 'ok');
  render();
};

$('resetBtn').onclick = () => {
  level = readSensor(); motorOn = false; totalUsage = 0;
  usageHistory.length = 0; fillHistory.length = 0;
  say('Reset. New sensor reading taken.', 'ok');
  render();
};

function tick() {
  const n = new Date();
  $('clock').textContent = n.toLocaleDateString('en-GB') + '  ' + n.toLocaleTimeString('en-GB');
}
tick(); setInterval(tick, 1000);
render();
</script>
</body>
</html>
